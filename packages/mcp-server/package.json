  },
  "dependencies": {
    "@mdlineage/validator": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  }
}
