{
  "name": "@mdlineage/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing @mdlineage/validator as model-facing tools (docs/remark-language-server-solution.md §12).",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "mdlineage-mcp": "./dist/entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-dc-coder/md-lineage.git",
    "directory": "packages/mcp-server"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/ensure-bin-exec.mjs",
    "prepack": "node ../../scripts/copy-schemas.mjs",
    "test": "node ../../scripts/run-tests.mjs .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mdlineage/validator": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  },
  "license": "MIT"
}
