{
  "name": "@mdlineage/language-server",
  "version": "0.0.0",
  "description": "Dedicated MDLineage Language Server: LSP diagnostics over the @mdlineage/validator workspace index.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "mdlineage-lsp": "./dist/server-entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@mdlineage/validator": "*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  }
}
