{
  "name": "@mdlineage/cli",
  "version": "0.2.1",
  "description": "mdlineage command line: single-document and repository Markdown validation through @mdlineage/validator.",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "mdlineage": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-dc-coder/md-lineage.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/ensure-bin-exec.mjs",
    "test": "node ../../scripts/run-tests.mjs .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mdlineage/language-server": "*",
    "@mdlineage/mcp-server": "*",
    "@mdlineage/validator": "*",
    "glob": "^10.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  },
  "license": "MIT"
}
