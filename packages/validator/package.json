{
  "name": "@mdlineage/validator",
  "version": "0.1.0",
  "description": "Transport-independent MDLineage validation core: front matter syntax, JSON Schema, single-document semantics, line-ending hygiene.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-dc-coder/md-lineage.git",
    "directory": "packages/validator"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/ensure-bin-exec.mjs",
    "prepack": "node ../../scripts/copy-schemas.mjs",
    "test": "node ../../scripts/run-tests.mjs ."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3"
  },
  "license": "MIT"
}
