{
  "name": "md-lineage",
  "version": "0.0.0",
  "private": true,
  "description": "MDLineage monorepo: transport-independent metadata validation for Markdown documents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint:md": "remark . --frail --no-stdout",
    "check:md": "mdlineage check .",
    "check:md:changed": "mdlineage check --changed",
    "test": "npm run build && node --import tsx --test \"packages/*/test/*.test.ts\""
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.0",
    "@types/unist": "^3.0.3",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-language-server": "^3.0.0",
    "remark-lint": "^10.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
